#pragma once

// Copy this file to secrets.h and fill in local values.
// secrets.h is gitignored — never commit real credentials.
// NEVER put Anthropic / OpenAI / xAI provider API keys here.

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// Backend base URL (no trailing slash), reachable from the ESP32 on your LAN.
// Example: "http://192.168.1.50:8787"
#define BACKEND_BASE_URL  "http://192.168.1.50:8787"

// Same value as backend DEVICE_TOKEN
#define DEVICE_TOKEN      "replace-with-long-random-device-token"
