# Copy to docker-compose.env and adjust only the host paths if needed.
# This file is for Compose path substitution, not provider credentials.
HOST_HOME=/home/bookchaowalit
HOST_UID=1000
HOST_GID=1000
QUOTA_HOST_DIR=/home/bookchaowalit/.local/share/ai-usage-display
SOLO_EMPIRE_DB_HOST_PATH=/home/bookchaowalit/book/solo-empire/infra/database/solo-empire.db
# Host interface for port 3000. The ESP32 needs it on the LAN: prefer the
# host's LAN IP over 0.0.0.0; use 127.0.0.1 when no device connects.
AI_USAGE_BIND=0.0.0.0
