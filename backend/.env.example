# Server
PORT=8787
HOST=0.0.0.0

# Required: shared secret for ESP32 (and curl). Generate a long random string.
# Example: openssl rand -hex 32
DEVICE_TOKEN=replace-with-long-random-device-token

# Cache TTL for aggregated usage responses (seconds)
CACHE_TTL_SECONDS=60

# How long a successful provider result may be served as "stale" after failure (seconds)
STALE_MAX_AGE_SECONDS=3600

# Usage source mode:
#   providers   — Anthropic / OpenAI / xAI Admin Usage APIs (default)
#   solo_empire — read-only ai_run_telemetry SQLite only
#   hybrid      — try provider APIs first; fill unavailable from Solo Empire telemetry
USAGE_SOURCE=hybrid

# Read paid-plan quota from authenticated local Claude/Codex/Grok/Kimi sessions.
# This is independent of token telemetry and does not copy credentials to ESP32.
SUBSCRIPTION_USAGE_ENABLED=true
SUBSCRIPTION_USAGE_TIMEOUT_MS=15000
# Snapshot exporters refresh every 60s; older data is reported as stale.
QUOTA_SNAPSHOT_MAX_AGE_SECONDS=300
# Optional executable overrides. Leave empty for PATH / VS Code extension discovery.
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=
CODEX_QUOTA_PATH=
GROK_CLI_PATH=
GROK_QUOTA_PATH=
# Kimi Code reads its local OAuth login and refreshes it under Kimi's own lock.
# Defaults: KIMI_CODE_HOME=~/.kimi-code and credentials/kimi-code.json
KIMI_CODE_HOME=
KIMI_CREDENTIALS_PATH=
KIMI_QUOTA_PATH=
KIMI_USAGE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_OAUTH_HOST=https://auth.kimi.com
# Optional; default is ~/.claude/.credentials.json
CLAUDE_CREDENTIALS_PATH=
# Optional host-exported Claude quota snapshot. Docker overrides this with
# /data/claude-quota.json.
CLAUDE_QUOTA_PATH=
# Optional Gemini quota snapshot. The host exporter writes this file; Docker
# normally overrides it with /data/gemini-quota.json.
GEMINI_QUOTA_PATH=

# --- Provider Admin / Usage credentials (backend only; never put on ESP32) ---
# Leave empty to mark that provider as unavailable.

# Anthropic Admin API (Usage & Cost) — Admin API key or OAuth token
ANTHROPIC_ADMIN_API_KEY=
# Optional override
ANTHROPIC_USAGE_BASE_URL=https://api.anthropic.com

# OpenAI Organization Admin key (usage + costs endpoints)
OPENAI_ADMIN_API_KEY=
OPENAI_USAGE_BASE_URL=https://api.openai.com

# xAI — if no public usage API is configured, status becomes unavailable
XAI_API_KEY=
XAI_USAGE_BASE_URL=https://api.x.ai
# Set to "true" only when you have a confirmed usage endpoint path
XAI_USAGE_ENABLED=false
XAI_USAGE_PATH=/v1/usage

# --- Solo Empire (read-only) ---
# Absolute or relative path to solo-empire.db (opened read-only).
# Example when running from this repo inside Solo Empire:
# SOLO_EMPIRE_DB_PATH=../../../../../../../../infra/database/solo-empire.db
SOLO_EMPIRE_DB_PATH=
# Optional absolute path to a read-only HTTP adapter that returns the same
# shape as GET /api/ai-usage (used instead of SQLite when set)
SOLO_EMPIRE_USAGE_API_URL=
SOLO_EMPIRE_USAGE_API_TOKEN=
